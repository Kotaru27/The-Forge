{
  "name": "the-forge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "prepare:legacy": "node scripts/materialize-legacy.mjs",
    "dev": "npm run prepare:legacy && vite --host 0.0.0.0",
    "build": "npm run prepare:legacy && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:bridge": "node --test tests/*.test.mjs",
    "test:legacy": "node scripts/test-legacy.mjs",
    "test": "npm run test:bridge && npm run test:legacy"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
